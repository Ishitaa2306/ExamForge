# ─────────────────────────────────────────────────────────────────────────────
# ExamForge — Environment Configuration
# Copy this file to .env and fill in your credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/examforge

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-secret-key-before-production

# ── AI Provider Mode ─────────────────────────────────────────────────────────
# Set to "mock" to run without any AI API credentials.
# Set to "live" to use real Gemini + Granite inference.
AI_PROVIDER_MODE=mock

# ── Google Gemini (required when AI_PROVIDER_MODE=live) ──────────────────────
GEMINI_API_KEY=

# ── IBM watsonx.ai / Granite (required when AI_PROVIDER_MODE=live) ───────────
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Storage ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=storage/uploads
CHROMA_DIR=storage/chroma
