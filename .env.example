# ==============================================================================
# ExamForge Environment Configuration Template
# Copy this file to .env and configure with your real API credentials
# ==============================================================================

# AI Provider Mode: 'live' (required for production AI inference)
AI_PROVIDER_MODE=live

# Google Gemini Configuration (Agents 1-4: Understanding, Questions, Exam, Reports)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash

# IBM watsonx.ai Granite Configuration (Agents 5-6: Answer Evaluation, Knowledge Assessment)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# Database Configuration (PostgreSQL primary database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/examforge

# Security / Authentication
JWT_SECRET_KEY=change-this-secret-key-before-production-use-a-secure-random-string

# Storage Settings
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=storage/uploads
CHROMA_DIR=storage/chroma

